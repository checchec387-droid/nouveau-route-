# -------------------------------------------------------------
# ARP ROAD DESIGN EXPERT – CONFIGURATION ENVIRONNEMENT (SANS E-MAIL)
# -------------------------------------------------------------
# URL de l'application
APP_URL="http://localhost:3000"

# Compte administrateur principal unique
ADMIN_EMAIL="youcefyoucefbelallia@gmail.com"

# Mot de passe initial de l'administrateur configuré serveur
# OBLIGATOIRE : Au moins 12 caractères requis. Le serveur refuse de démarrer s'il est absent ou trop court.
ADMIN_INITIAL_PASSWORD="VOTRE_MOT_DE_PASSE_ADMIN_MIN_12_CARACTERES"

# Clé de secours administrative d'urgence (indépendante des e-mails)
# OBLIGATOIRE : Au moins 24 caractères requis. Le serveur refuse de démarrer si elle est absente ou trop courte.
ADMIN_RECOVERY_KEY="VOTRE_CLE_DE_SECOURS_ADMIN_MIN_24_CARACTERES"

# Clé secrète de signature des sessions et cookies
SESSION_SECRET="arp-ultra-secure-session-key-change-in-production"

# Base de données persistante PostgreSQL (ex: Supabase, Neon, Cloud SQL)
# Si omis, l'application utilise le stockage local persistant sécurisé (data/app_database.json)
DATABASE_URL=""

# Node environment & Port
NODE_ENV="development"
PORT="3000"
